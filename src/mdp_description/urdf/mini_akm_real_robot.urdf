<?xml version="1.0" encoding="utf-8"?>
<!-- Mini Ackermann Robot URDF for Real Hardware (topic_based_ros2_control) -->
<robot name="mini_akm_robot">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0119754973846389 -0.000133372463647142 0.021017784029409" rpy="0 0 0" />
      <mass value="0.431538267108837" />
      <inertia ixx="0.00025452933099881" ixy="1.90798049636859E-06" ixz="-8.81627294628033E-07" iyy="0.00037243817570695" iyz="4.03071469874943E-07" izz="0.000540327179164314" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/base_link.STL" />
      </geometry>
      <material name=""><color rgba="0.741176470588235 0.901960784313726 0.956862745098039 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="lb_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/lb_link.STL" /></geometry>
    </visual>
  </link>
  <joint name="lb_joint" type="continuous">
    <origin xyz="-0.069657 0.07975 0.0162" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lb_link" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="rb_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/rb_link.STL" /></geometry>
    </visual>
  </link>
  <joint name="rb_joint" type="continuous">
    <origin xyz="-0.069657 -0.079776 0.0162" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rb_link" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/left_link.STL" /></geometry>
    </visual>
  </link>
  <joint name="left_joint" type="revolute">
    <origin xyz="0.073593 0.051987 0.022" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.39" upper="0.39" effort="10.0" velocity="5.0" />
  </joint>

  <link name="right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://mdp_description/meshes/mini_akm_robot_meshes/right_link.STL" /></geometry>
    </visual>
  </link>
  <joint name="right_joint" type="revolute">
    <origin xyz="0.0735933420063898 -0.0520125752742397 0.0219999999999997" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.39" upper="0.39" effort="10.0" velocity="5.0" />
  </joint>

  <ros2_control name="TopicBasedSystem" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/joint_commands</param>
      <!-- Deliberately NOT /joint_states: joint_state_broadcaster re-publishes
           the aggregated state interfaces on that exact name for the rest of
           the graph (RViz, TF, etc). If TopicBasedSystem's raw hardware-feedback
           subscription used the same name, two independently-ordered
           publishers would collide on one topic - see docs/ros/launch.md's
           note on this remap for what that looked like before the fix. -->
      <param name="joint_states_topic">/joint_states_raw</param>
    </hardware>
    <joint name="left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lb_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rb_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
