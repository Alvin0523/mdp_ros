<?xml version="1.0" ?>
<!--
  Task 1 arena: 2.0m x 2.0m exploration grid - floor, zones, lights, plugins.

  OBSTACLES ARE NOT IN THIS FILE. mdp.launch.py (sim:=true task:=1) reads the
  layout YAML (mdp_bringup/config/test_obstacles.yaml by default, `layout:=`
  to pick another), inserts one model per obstacle at the <!- - OBSTACLES - ->
  marker below via mdp_bringup/scripts/obstacle_layout.py, and loads the
  result. The same YAML goes to the planner (obstacles:=yaml / pixi run
  setup), so Gazebo and the planner cannot disagree about where they are.

  COORDINATE CONVENTION (matches the planner): arena (0,0) is the BOTTOM-LEFT
  corner, x/y run 0 -> 2.0m; world origin = that corner.
-->
<sdf version="1.8">
  <world name="task1_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>1 1 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2.0m x 2.0m placement zone, corner at world (0,0). -->
    <model name="arena_zone">
      <static>true</static>
      <pose>1.0 1.0 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.001</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 40cm x 40cm start box, corner at world (0,0). -->
    <model name="carpark_zone">
      <static>true</static>
      <pose>0.20 0.20 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.002</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 0.5</ambient>
            <diffuse>0.2 0.8 0.2 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

  
    <!-- OBSTACLES -->

  </world>
</sdf>
