<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="task2_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sun Light Source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane Arena (2.0m x 2.0m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Carpark Zone Visual Boundary (60cm x 50cm at 0, 0) -->
    <model name="carpark_zone">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.5 0.002</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 0.5</ambient>
            <diffuse>0.2 0.8 0.2 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         OBSTACLES - baked in, same reasoning as task1_arena.sdf: obstacles
         must exist at world load or the decal renders black (texture never
         binds in ogre2), so there is no runtime spawner here.

         Positions/sizes/colors mirror task2_runner.py's ARENA_GEOMETRY - keep
         both in step by hand if either changes. Facing is WEST (yaw +pi/2):
         the robot drives from the carpark at x=0 out toward +x, so the west
         (-x) face of each obstacle is what its camera sees on approach.
         Decal placement follows task1_arena.sdf's geometry rules (see that
         file's header comment for the full derivation): offset = half-width
         + 0.0015 clearance, flush with the top of the obstacle.
         ===================================================================== -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.0 0.0 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.20</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.10 0.10 0.20</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="symbol">
          <!-- Arrow LEFT - matches task2_runner.py's default self.arrow1 -->
          <pose>-0.0515 0.0 0.0695 0.0 0.0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://mdp_description/models/symbols/39_ArrowLeft.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>1.8 0.0 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.30 0.20</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.10 0.30 0.20</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <visual name="symbol">
          <!-- Arrow RIGHT - matches task2_runner.py's default self.arrow2 -->
          <pose>-0.0515 0.0 0.0695 0.0 0.0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://mdp_description/models/symbols/38_ArrowRight.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
