// `pixi run sim-car`: a task 2 sim run split like the real car (`pixi run car`), one window.
//   left         the car's half: Gazebo + everything the Pi runs (`pixi run sim task:=2`)
//   right top    the laptop's half: YOLO, planner, bags, snapshots (`pixi run laptop sim:=true task:=2`)
//   right bottom Foxglove's bridge: `pixi run foxglove`
// Ctrl+C stops a pane's command; the pane never closes (scripts/keep.sh): ENTER runs it again.
// Quit everything: Ctrl+Q.
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        pane name="car (sim)" command="bash" size="55%" {
            args "scripts/keep.sh" "pixi" "run" "sim" "task:=2"
        }
        pane split_direction="horizontal" {
            pane name="laptop" command="bash" {
                args "scripts/keep.sh" "pixi" "run" "laptop" "sim:=true" "task:=2"
            }
            pane name="foxglove" command="bash" size="30%" {
                args "scripts/keep.sh" "pixi" "run" "foxglove"
            }
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
