// `pixi run car`: everything for a real task 2 run, one window (zellij).
//   left        the car: waits for the Pi, SSHes in, `pixi run pi task:=2`
//   right top   the laptop: `pixi run laptop task:=2` (YOLO, planner, bags, snapshots)
//   right bottom Foxglove's bridge: `pixi run foxglove`
// Ctrl+C stops a pane's command; the pane never closes (scripts/keep.sh): ENTER runs it again.
// Quit everything: Ctrl+Q.
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        pane name="car (Pi)" command="bash" size="55%" {
            args "scripts/keep.sh" "bash" "scripts/pi_run.sh" "2"
        }
        pane split_direction="horizontal" {
            pane name="laptop" command="bash" {
                args "scripts/keep.sh" "pixi" "run" "laptop" "task:=2"
            }
            pane name="foxglove" command="bash" size="30%" {
                args "scripts/keep.sh" "pixi" "run" "foxglove"
            }
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
